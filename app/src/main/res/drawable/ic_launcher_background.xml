<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background. A flat fill would be fine, but the launcher renders this at 108dp and a
  faint diagonal ramp keeps the mark from looking like a sticker next to icons that have depth.
  Both stops come from the Basil ramp in ui/theme/Color.kt — the icon and the app are the same green.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#FF35906A" />
                <item android:offset="1" android:color="#FF24623E" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
