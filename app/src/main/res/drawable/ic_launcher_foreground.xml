<?xml version="1.0" encoding="utf-8"?>
<!--
  TasteRoute's mark: a map pin with a fork cut out of it.
  
  One shape, one colour, no detail smaller than a couple of dp — which is what makes it survive
  being drawn at 48dp in a launcher, and what makes the SAME drawable usable as the monochrome
  themed icon, where the system throws away the colour and keeps only the silhouette. A mark with
  an outlined fork sitting on top of a pin would lose the fork entirely at that point.
  
  Everything lives inside the 66dp centre circle the adaptive mask guarantees is visible: the pin
  spans y 24..84 of a 108 viewport, so nothing important is inside the 18dp the launcher may crop.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
      Pin outline followed by the fork outline, evenOdd so the second becomes a hole in the first.
      The fork's tine notches dip to y=44 and climb back — that is the outline tracing into each
      gap, not a stray line.
    -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M54,24 C41.3,24 31,34.3 31,47 C31,58 43,70 54,84 C65,70 77,58 77,47 C77,34.3 66.7,24 54,24 Z M47.7,34 L49.5,34 L49.5,44 L51.3,44 L51.3,34 L53.1,34 L53.1,44 L54.9,44 L54.9,34 L56.7,34 L56.7,44 L58.5,44 L58.5,34 L60.3,34 L60.3,47 C60.3,50.2 58.1,52.9 55.2,53.6 L55.2,64 L52.8,64 L52.8,53.6 C49.9,52.9 47.7,50.2 47.7,47 Z" />
</vector>
